{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://root-architect-execution/schemas/runtime-attempt.schema.json",
  "title": "Runtime attempt version 2",
  "type": "object",
  "required": ["schema_version", "run_id", "task_id", "attempt_id", "provider_thread_id", "provider_turn_id", "provider_event_id", "family", "selected_template", "template_catalog_sha256", "requested_model_tier", "requested_effort", "resolved_model", "resolved_effort", "effective_model", "effective_effort", "started_at", "last_activity_at", "deadline_at", "last_envelope_id", "observed_activity_state", "provider_observed_at", "local_bookkeeping_at", "controller_lease_expires_at", "state"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "provider_thread_id": { "type": ["string", "null"] },
    "provider_turn_id": { "type": ["string", "null"] },
    "provider_event_id": { "type": ["string", "null"] },
    "family": { "type": "string", "enum": ["implementer", "spec-validator", "quality-validator"] },
    "selected_template": { "type": "string", "minLength": 1 },
    "template_catalog_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "requested_model_tier": { "type": "string", "enum": ["cheap", "mid", "strong"] },
    "requested_effort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"] },
    "resolved_model": { "type": "string", "minLength": 1 },
    "resolved_effort": { "type": ["string", "null"], "enum": ["low", "medium", "high", "xhigh", "max", null] },
    "effective_model": { "type": ["string", "null"], "minLength": 1 },
    "effective_effort": { "type": ["string", "null"], "enum": ["low", "medium", "high", "xhigh", "max", null] },
    "started_at": { "type": "string", "minLength": 1 },
    "last_activity_at": { "type": "string", "minLength": 1 },
    "deadline_at": { "type": "string", "minLength": 1 },
    "last_envelope_id": { "type": ["string", "null"] },
    "observed_activity_state": { "type": "string", "enum": ["active", "waiting_approval", "waiting_input", "completed", "stopped", "unknown"] },
    "provider_observed_at": { "type": ["string", "null"] },
    "local_bookkeeping_at": { "type": "string", "minLength": 1 },
    "controller_lease_expires_at": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "enum": ["reserved", "starting", "active", "captured", "validated", "invalid", "start_failed", "cancel_requested", "stopped", "stop_unknown"] }
  }
}
