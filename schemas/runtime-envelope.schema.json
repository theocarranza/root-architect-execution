{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://root-architect-execution/schemas/runtime-envelope.schema.json",
  "title": "Runtime envelope version 2",
  "type": "object",
  "required": ["schema_version", "envelope_id", "run_id", "task_id", "attempt_id", "kind", "from", "to", "captured_by", "capture_source", "reply_to", "family", "selected_template", "template_catalog_sha256", "requested_model_tier", "requested_effort", "resolved_model", "resolved_effort", "effective_model", "effective_effort", "body_sha256", "created_at", "provider_thread_id", "provider_turn_id", "provider_event_id"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "envelope_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": ["string", "null"] },
    "attempt_id": { "type": ["string", "null"] },
    "kind": { "type": "string", "enum": ["task", "answer", "report", "question", "outcome", "failure", "lifecycle"] },
    "from": { "type": "string", "pattern": "^(root|orchestrator|worker:[a-z][a-z0-9-]*|controller:[a-z][a-z0-9-]*)$" },
    "to": { "type": "string", "pattern": "^(root|orchestrator|worker:[a-z][a-z0-9-]*)$" },
    "captured_by": { "type": "string", "pattern": "^controller:[a-z][a-z0-9-]*$" },
    "capture_source": { "const": "controller" },
    "reply_to": { "type": ["string", "null"] },
    "family": { "type": ["string", "null"], "enum": ["implementer", "spec-validator", "quality-validator", null] },
    "selected_template": { "type": ["string", "null"], "minLength": 1 },
    "template_catalog_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "requested_model_tier": { "type": ["string", "null"], "enum": ["cheap", "mid", "strong", null] },
    "requested_effort": { "type": ["string", "null"], "enum": ["low", "medium", "high", "xhigh", "max", null] },
    "resolved_model": { "type": ["string", "null"], "minLength": 1 },
    "resolved_effort": { "type": ["string", "null"], "enum": ["low", "medium", "high", "xhigh", "max", null] },
    "effective_model": { "type": ["string", "null"], "minLength": 1 },
    "effective_effort": { "type": ["string", "null"], "enum": ["low", "medium", "high", "xhigh", "max", null] },
    "body_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "created_at": { "type": "string", "minLength": 1 },
    "provider_thread_id": { "type": ["string", "null"] },
    "provider_turn_id": { "type": ["string", "null"] },
    "provider_event_id": { "type": ["string", "null"] }
  }
}
