{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://root-architect-execution/schemas/runtime-run.schema.json",
  "title": "Runtime run version 2",
  "type": "object",
  "required": ["schema_version", "run_id", "host_id", "workspace_fingerprint", "configuration_fingerprint", "principal_id", "created_at", "state"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "type": "string", "minLength": 1 },
    "host_id": { "type": "string", "minLength": 1 },
    "workspace_fingerprint": { "type": "string", "minLength": 1 },
    "configuration_fingerprint": { "type": "string", "minLength": 1 },
    "principal_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "enum": ["created", "admitted", "running", "blocked", "completed", "abandoned"] }
  }
}
