{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://root-architect-execution/schemas/orchestrator-outcome.schema.json",
  "title": "Orchestrator outcome version 2",
  "description": "A decision backed by immutable runtime record identifiers, never by counts or filenames.",
  "type": "object",
  "required": ["schema_version", "run_id", "outcome", "rationale"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "enum": ["accepted", "rejected", "blocked", "abandoned"]},
    "validated_attempt_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "orchestrator_decision_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "execution_evidence": {
      "type": "array",
      "minItems": 1,
      "description": "Controller-recorded command observations; worker pass counts alone are not execution evidence.",
      "items": {
        "type": "object",
        "required": ["evidence_ref", "captured_by", "capture_source", "command", "output", "exit_status", "tested_tree_fingerprint"],
        "additionalProperties": false,
        "properties": {
          "evidence_ref": {"type": "string", "minLength": 1},
          "captured_by": {"type": "string", "pattern": "^controller:[a-z][a-z0-9-]*$"},
          "capture_source": {"const": "controller"},
          "command": {"type": "string", "minLength": 1},
          "output": {"type": "string"},
          "exit_status": {"type": "integer"},
          "tested_tree_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "rationale": {"type": "string", "minLength": 1},
    "blocked_reason": {"type": "string", "minLength": 1},
    "question_or_failure_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
